module container

import "std"

// Types
// -----------------------------------------------------------------------------

pub type Healthcheck {
  cmd:      string
  interval: string = "30s"
  timeout:  string = "30s"
  retries:  int = 3
}

// Enums
// -----------------------------------------------------------------------------

pub enum State { running, stopped, absent }
pub enum Restart { always, on_failure, unless_stopped, no }

// Steps
// -----------------------------------------------------------------------------

// Manage container lifecycle: running, stopped, or absent
pub decl instance(
  name:        string
  image:       string = ""
  state:       State = State.running
  restart:     Restart = Restart.unless_stopped
  ports:       list[string]?
  env:         map[string, string]?
  // bind mounts
  mounts:      list[string]?
  // entrypoint arguments
  args:        list[string]?
  labels:      map[string, string]?
  healthcheck: Healthcheck?
  desc:        string?
  on_change:   list[std.Step] = []
  provides:    list[string] = []
  requires:    list[string] = []
) std.Step

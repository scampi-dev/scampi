module main

import "std"
import "std/posix"
import "std/local"

let host = local.target { name = "local" }

std.deploy(name = "test", targets = [host]) {
  posix.mount {
    desc    = "data volume kept in fstab only"
    src     = "/dev/sdb1"
    dest    = "/mnt/data"
    fs_type = posix.MountType.ext4
    state   = posix.MountState.unmounted
  }
}
